# Copy to .env and adjust. Read by docker compose (variable interpolation + env_file)
# and by the application itself (pydantic-settings), so it also works outside Docker.

# --- API ---
API_KEY=change-me
SYNC_MAX_POINTS=20000
ASYNC_MAX_POINTS=500000

# --- Model served (MLflow Model Registry) ---
MODEL_NAME=mscvae-synthetic
MODEL_ALIAS=champion
# Seconds between checks for a new @champion version (0 = no hot reload).
MODEL_REFRESH_INTERVAL_S=15
# Serve a local bundle instead of the registry (development):
# MODEL_PATH=artifacts/demo

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Outside Docker only (inside Docker these are set by docker-compose.yml) ---
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# REDIS_URL=redis://localhost:6379/0
# Run jobs inside the API process instead of a worker (job status still uses Redis):
# CELERY_TASK_ALWAYS_EAGER=true

# --- Host ports ---
# MLflow UI (5000 is taken by the AirPlay Receiver on macOS)
MLFLOW_PORT=5050

# --- Monitoring profile ---
GRAFANA_ADMIN_PASSWORD=admin
